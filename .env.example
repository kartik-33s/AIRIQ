# GEMINI_API_KEY: Required for Gemini AI API calls (AI Assistant & Insights).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WAQI_TOKEN: Optional API token for WAQI / aqicn.org ground stations.
# A default public demo token is used as fallback when not provided.
WAQI_TOKEN=""

# OPENAQ_API_KEY: Optional API key for OpenAQ v3 API ground-station data.
OPENAQ_API_KEY=""

